  name: "search"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /search"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "api_key"
                or: "api_key"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "cr"
                or: "cr"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "desktop"
                k: "query"
                n: "device"
                or: "device"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "engine"
                or: "engine"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "1"
                k: "query"
                n: "filter"
                or: "filter"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "gl"
                or: "gl"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "en"
                k: "query"
                n: "hl"
                or: "hl"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "kgmid"
                or: "kgmid"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "latitude"
                or: "latitude"
                r: false
                t: "`$NUMBER`"
              }
              {
                ex: "raw"
                k: "query"
                n: "link"
                or: "link"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "location"
                or: "location"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "longitude"
                or: "longitude"
                r: false
                t: "`$NUMBER`"
              }
              {
                ex: "lang_en|lang_de"
                k: "query"
                n: "lr"
                or: "lr"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "0"
                k: "query"
                n: "nfpr"
                or: "nfpr"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "performance"
                k: "query"
                n: "optimization_strategy"
                or: "optimization_strategy"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "q"
                or: "q"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "blur"
                k: "query"
                n: "safe"
                or: "safe"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "time_period"
                or: "time_period"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "time_period_max"
                or: "time_period_max"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "time_period_min"
                or: "time_period_min"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "uule"
                or: "uule"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "verbatim"
                or: "verbatim"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/search"
          q: {
            exist: [
              "api_key"
              "cr"
              "device"
              "engine"
              "filter"
              "gl"
              "hl"
              "kgmid"
              "latitude"
              "link"
              "location"
              "longitude"
              "lr"
              "nfpr"
              "optimization_strategy"
              "page"
              "q"
              "safe"
              "time_period"
              "time_period_max"
              "time_period_min"
              "uule"
              "verbatim"
            ]
          }
          s: [
            {
              lit: "search"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



